<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vt5_black"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/rootContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="30dp"
        android:paddingRight="20dp"
        android:paddingBottom="40dp">

        <!-- Uitleg -->
        <TextView
            android:id="@+id/tvInstallatieTitel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titel_install"
            android:textColor="@color/vt5_light_blue"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/etUitleg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/install_uitleg"
            android:textColor="@color/vt5_on_surface"
            android:textSize="13sp" />

        <!-- Toestemmingen Sectie -->
        <TextView
            android:id="@+id/tvPermissiesTitel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/install_permissions_title"
            android:textColor="@color/vt5_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1A1A1A"
            android:orientation="vertical"
            android:padding="8dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbPermAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_audio_checkbox"
                android:textColor="@color/vt5_on_surface"
                app:buttonTint="@color/vt5_light_blue" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbPermLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_location_checkbox"
                android:textColor="@color/vt5_on_surface"
                app:buttonTint="@color/vt5_light_blue" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbPermCamera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_camera_checkbox"
                android:textColor="@color/vt5_on_surface"
                app:buttonTint="@color/vt5_light_blue" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbPermBluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_bluetooth_checkbox"
                android:textColor="@color/vt5_on_surface"
                app:buttonTint="@color/vt5_light_blue" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbPermAlarm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_alarm_checkbox"
                android:textColor="@color/vt5_on_surface"
                app:buttonTint="@color/vt5_light_blue" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbPermSaf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perm_saf_checkbox"
                android:textColor="@color/vt5_on_surface"
                app:buttonTint="@color/vt5_light_blue" />
        </LinearLayout>

        <!-- Installatiehulp -->
        <TextView
            android:id="@+id/tvInstallatieHelpTitel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/install_unknown_sources_title"
            android:textColor="@color/vt5_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenUnknownSources"
            style="@style/Widget.VT5.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/install_unknown_sources_button" />

        <!-- Bestandsbeheer (SAF) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/hoofd_telpost_beheer"
            android:textColor="@color/vt5_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKiesDocuments"
            style="@style/Widget.VT5.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_kies_documents" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckFolders"
            style="@style/Widget.VT5.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_check_folders" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAlignment="center"
            android:textColor="@color/vt5_light_blue"
            android:textStyle="italic" />

        <!-- Trektellen sectie -->
        <TextView
            android:id="@+id/tvSectTrektellen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sect_trektellen"
            android:textColor="@color/vt5_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_login">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_password"
            app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/rowCreds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWis"
                style="@style/Widget.VT5.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/btn_wis" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBewaar"
                style="@style/Widget.VT5.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/btn_bewaar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowAuthDownload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoginTest"
                style="@style/Widget.VT5.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/btn_login_test" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadJsons"
                style="@style/Widget.VT5.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/btn_download_jsons" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAliasPrecompute"
            style="@style/Widget.VT5.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_alias_precompute" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKlaar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/vt5_btn_confirm_selector"
            android:text="@string/btn_klaar"
            android:textColor="@color/vt5_white"
            android:textStyle="bold"
            app:backgroundTint="@color/vt5_outline" />

    </LinearLayout>
</ScrollView>
