<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Achtergrondafbeelding settings.png -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/settings" />

    <!-- Transparante sfeeroverlay voor optimale leesbaarheid -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#85080E14" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="36dp"
            android:paddingRight="20dp"
            android:paddingBottom="40dp">

            <!-- HEADER MET TERUG KNOP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTerug"
                    style="@style/Widget.VT5.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:text="←"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTitel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Trektellen Excel Export"
                        android:textColor="@color/vt5_white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Automatische import van header- en data-bestanden"
                        android:textColor="#D0FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- CARD 1: SECTIE AUTHENTICATIE / LOGIN WEBVIEW             -->
            <!-- ======================================================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="AUTHENTICATIE &amp; SESSIE"
                android:textColor="@color/vt5_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLoginSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#CC121A24"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#227CAF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvCookieStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textColor="@color/vt5_white"
                        android:textSize="13sp" />

                    <!-- Embedded WebView voor eenmalige inlogflow -->
                    <WebView
                        android:id="@+id/wvLogin"
                        android:layout_width="match_parent"
                        android:layout_height="380dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetLogin"
                        style="@style/Widget.VT5.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Opnieuw inloggen (Wis opgeslagen sessie)"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== -->
            <!-- CARD 2: SECTIE EXPORT OPTIES                             -->
            <!-- ======================================================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="EXPORT PARAMETERS"
                android:textColor="@color/vt5_white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDownloadSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#CC121A24"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#227CAF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- TELPOST DROPDOWN -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selecteer Telpost:"
                        android:textColor="#A0FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerTelpost"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/vt5_input_background" />

                    <!-- VROEGSTE JAAR INVOER & JAARTAL DROPDOWN -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Selecteer Jaartal:"
                            android:textColor="#A0FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vroegste jaar: "
                            android:textColor="#A0FFFFFF"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etStartYear"
                            android:layout_width="75dp"
                            android:layout_height="40dp"
                            android:background="@drawable/vt5_input_background"
                            android:inputType="number"
                            android:text="1960"
                            android:textAlignment="center"
                            android:textColor="@color/vt5_white"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinnerJaar"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/vt5_input_background" />

                    <CheckBox
                        android:id="@+id/chkValidatePk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:checked="true"
                        android:text="Valideer binaire 'PK' Excel-handtekening"
                        android:textColor="@color/vt5_white"
                        android:textSize="13sp" />

                    <!-- HOOFDKNOP GLASSTIJL -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartDownload"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/vt5_btn_glass_primary"
                        android:text="START BATCH DOWNLOAD"
                        android:textColor="@color/vt5_white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:rippleColor="#40D97A" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== -->
            <!-- CARD 3: OPKLAPPEND RESULTAAT VENSTER                     -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResultSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="#CC121A24"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#3DDC84"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- INKLAPBARE HEADER BALK -->
                    <LinearLayout
                        android:id="@+id/layoutResultHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvResultHeaderTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RESULTAAT IMPORTSESSIE"
                            android:textColor="#3DDC84"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleResult"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="40dp"
                            android:text="▲"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- INKLAPBAAR INHOUDSVENSTER MET EIGEN SCROLLBAR -->
                    <LinearLayout
                        android:id="@+id/layoutResultContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <androidx.core.widget.NestedScrollView
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:background="#40000000"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tvResultReport"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textColor="@color/vt5_white"
                                android:textSize="12sp" />
                        </androidx.core.widget.NestedScrollView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>