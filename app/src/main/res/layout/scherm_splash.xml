<?xml version="1.0" encoding="utf-8"?>
<!-- 
    VT5 Splash Screen Layout
    Toont het opstartscherm.webp schermvullend.
    Inclusief progressie indicator voor data pre-loading.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vt5_black"
    android:fitsSystemWindows="true">

    <!-- Schermvullende Opstartafbeelding -->
    <ImageView
        android:id="@+id/ivSplashLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/opstartscherm" />

    <!-- AI Layer: BSI-powered oog dat de plaats inneemt bij BSI transitie -->
    <LinearLayout
        android:id="@+id/containerAiLogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivAiLogo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="BSI Logo"
            android:src="@drawable/ic_vt5_ai_horizon" />

        <TextView
            android:id="@+id/tvBsiTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bio Statistic Intelligence"
            android:textColor="#117CAF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:id="@+id/pbLoading"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/vt5_light_blue" />

        <TextView
            android:id="@+id/tvSplashVersion"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="VoiceTally with Bio Statistic Intelligence v4.0.0"
            android:textAlignment="center"
            android:textColor="#83FFFFFF"
            android:textColorLink="@color/grafiek_achtergrondkleur"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
