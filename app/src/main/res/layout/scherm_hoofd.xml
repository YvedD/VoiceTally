<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Achtergrondafbeelding phone.png -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_phone" />

    <!-- Lichte sfeeroverlay voor optimale zichtbaarheid van de foto én tekst -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#70080E14" />

    <!-- Scrollbare Inhoud -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="48dp"
            android:paddingRight="20dp"
            android:paddingBottom="40dp">

            <!-- Titel Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="36dp">

                <TextView
                    android:id="@+id/tvTitel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/titel_hoofd"
                    android:textAlignment="center"
                    android:textColor="@color/vt5_white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Spraakgestuurde invoer van trektelgegevens"
                    android:textAlignment="center"
                    android:textColor="#D0FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- VEREEENVOUDIGD STARTSCHERM: TELLING STARTEN KNOP (BOVEN) -->
            <!-- ======================================================== -->

            <!-- KNOP 1: TELLING STARTEN / HERVATTEN (GECENTREERD) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerder"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/vt5_btn_glass_primary"
                android:text="TELLING STARTEN / HERVATTEN"
                android:textColor="@color/vt5_white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_action_add"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/vt5_white"
                app:rippleColor="#40D97A" />

            <!-- ======================================================== -->
            <!-- INKLAPBAAR PANEL VOOR ALLE OVERIGE BEHEER EN INSTELLINGEN -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutOptiesMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="OVERIGE FUNCTIES &amp; INSTELLINGEN"
                    android:textAlignment="center"
                    android:textColor="#A0FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- KAART: Snelstart extra's -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#99121A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#117CAF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnInstall"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="@string/titel_install"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnJoinAsClient"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mc_btn_join_as_client"
                            android:textSize="15sp"
                            app:icon="@drawable/ic_mc_wifi"
                            app:iconTint="@color/vt5_white" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KAART: Alarm -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#99121A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#3DDC84"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvAlarmStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="8dp"
                            android:textColor="@color/vt5_on_surface"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleAlarm"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hoofd_alarm_toggle"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KAART: Beheer & Instellingen -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#99121A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#5D748C"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBewerkTellingen"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hoofd_bewerk_tellingen"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpkuisExports"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/hoofd_opkuis_exports"
                            android:textSize="14sp" />


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTelpostBeheer"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/hoofd_telpost_beheer"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KAART: Biologische Intelligentie (AI) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#99121A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#117CAF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="BIO STATISTIC INTELLIGENTIE (BSI)"
                            android:textColor="@color/vt5_light_blue"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBsiDatacentrum"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/vt5_btn_glass_primary"
                            android:text="BSI DATACENTRUM (GIDS &amp; PIJPLIJN)"
                            android:textColor="@color/vt5_white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null"
                            app:icon="@drawable/ic_vt5_ai_horizon"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp"
                            app:iconSize="24dp"
                            app:iconTint="@color/vt5_white"
                            app:rippleColor="#40D97A" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAiUpdate"
                                    style="@style/Widget.VT5.Button.Outlined"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/hoofd_ai_update"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/badgeAiUpdate"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="top|end"
                                    android:layout_marginTop="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/vt5_badge_red"
                                    android:gravity="center"
                                    android:text="@string/badge_warning"
                                    android:textColor="@color/vt5_white"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAiForecast3Days"
                                style="@style/Widget.VT5.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="@string/hoofd_ai_forecast_3days"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAiDailyReports"
                                    style="@style/Widget.VT5.Button.Outlined"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Teldag Verslagen"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/badgeAiDailyReports"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="top|end"
                                    android:layout_marginTop="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/vt5_badge_red"
                                    android:gravity="center"
                                    android:text="@string/badge_warning"
                                    android:textColor="@color/vt5_white"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAiTrain"
                                    style="@style/Widget.VT5.Button.Outlined"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="BSI Trainen"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/badgeAiTrain"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="top|end"
                                    android:layout_marginTop="4dp"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/vt5_badge_red"
                                    android:gravity="center"
                                    android:text="@string/badge_warning"
                                    android:textColor="@color/vt5_white"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- KAART: Database Beheer -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#99121A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#5D748C"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDatabaseBeheer"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/hoofd_database_beheer"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- SPACER WAARDOOR DE ONDERSTE KNOPPEN ALTIJD HELEMAAL ONDERAAN HET SCHERM ZITTEN -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- ONDERSTE RIJ: BEHEER & OPTIES (LINKS) EN AFSLUITEN (RECHTS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- KNOP: BEHEER & OPTIES (LINKS) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOptiesMenu"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/vt5_btn_glass_secondary"
                    android:text="BEHEER &amp; OPTIES"
                    android:textColor="@color/vt5_white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:rippleColor="#40117CAF" />

                <!-- KNOP: AFSLUITEN (RECHTS) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAfsluiten"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/vt5_btn_glass_secondary"
                    android:text="@string/btn_afsluiten"
                    android:textColor="@color/vt5_white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:rippleColor="#40EF6929"
                    app:strokeColor="@color/vt5_orange"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Helemaal bovenaan rechts in het element 'root' (Transparante achtergrond) -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="@style/Widget.VT5.Button.Outlined.IconOnly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/hoofd_instellingen"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_gear"
            app:iconTint="@color/vt5_white"
            app:strokeWidth="0dp" />

        <TextView
            android:id="@+id/badgeAppUpdate"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/vt5_badge_red"
            android:gravity="center"
            android:text="@string/badge_warning"
            android:textColor="@color/vt5_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
