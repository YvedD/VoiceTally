<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSuggestion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="12dp"
    app:strokeColor="#333333"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivSpecies"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tvSpeciesName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:textColor="@color/vt5_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvExpectedIndex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:textColor="@color/vt5_white"
                        android:alpha="0.8"
                        android:textSize="14sp" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvGuild"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vt5_white"
                    android:alpha="0.6"
                    android:textAllCaps="true"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvScientificInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/vt5_green"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvHistoric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/vt5_orange"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/clGraphContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#222222"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">
            <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                android:id="@+id/sparklinePhenology"
                android:layout_width="366dp"
                android:layout_height="45dp"
                android:layout_gravity="center_horizontal" />
            <View
                android:id="@+id/viewDateIndicator"
                android:layout_width="1.5dp"
                android:layout_height="45dp"
                android:background="#FF0000"
                android:elevation="4dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
