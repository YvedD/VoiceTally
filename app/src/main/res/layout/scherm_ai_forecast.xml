<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vt5_black"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="BSI 3-daagse Prognose"
        android:textColor="@color/vt5_light_blue"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Telpost Selection Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTelpostSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="4dp"
        app:cardBackgroundColor="#1A222D"
        app:cardCornerRadius="10dp"
        app:strokeColor="@color/vt5_light_blue"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTelpostTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 PROGNOSE TELPOST"
                    android:textColor="@color/vt5_light_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedTelpostInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Laden telpost..."
                    android:textColor="@color/vt5_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeTelpost"
                style="@style/Widget.VT5.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WIJZIG 📍"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Start Forecast Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartForecastCalculation"
        style="@style/Widget.VT5.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="6dp"
        android:padding="12dp"
        android:text="🚀 BEREKEN 3-DAAGSE PROGNOSE"
        android:textColor="@color/vt5_light_blue"
        android:textSize="15sp"
        android:textStyle="bold"
        app:strokeColor="@color/vt5_light_blue"
        app:strokeWidth="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/forecastContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/Widget.VT5.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Terug naar hoofdscherm" />

</LinearLayout>
