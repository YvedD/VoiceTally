<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <path
        android:pathData="M50,50m-40,0a40,40 0,1 1,80 0a40,40 0,1 1,-80 0"
        android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient android:startX="10" android:startY="50" android:endX="90" android:endY="50">
                <item android:color="#117CAF" android:offset="0" />
                <item android:color="#FF9800" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- De Oogkas / Horizon -->
    <path android:pathData="M25,50 Q50,25 75,50 Q50,75 25,50 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="50" android:centerY="50" android:gradientRadius="25">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#F0F0F0" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- De Iris (Biologische Intelligentie) -->
    <path android:pathData="M50,50m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="50" android:centerY="50" android:gradientRadius="12">
                <item android:color="#0D5C8A" android:offset="0" />
                <item android:color="#117CAF" android:offset="0.7" />
                <item android:color="#083E5C" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Tech-ring in de iris -->
    <path
        android:strokeColor="#44FFFFFF"
        android:strokeWidth="0.2"
        android:pathData="M50,50m-9,0a9,9 0,1 1,18 0a9,9 0,1 1,-18 0" />

    <!-- De Windroos / Pupil (Focus) -->
    <path android:fillColor="#FFFFFF" android:pathData="M50,42 L51.5,49 L50,50 L48.5,49 Z" /> <!-- Noord -->
    <path android:fillColor="#FF9800" android:pathData="M50,58 L48.5,51 L50,50 L51.5,51 Z" /> <!-- Zuid -->

    <!-- BSI Label is nu verwijderd uit vector en wordt via layout getoond voor maximale scherpte -->
</vector>
