<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="45dp"
    android:layout_marginBottom="60dp"
    android:background="@color/vt5_black"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/rootContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="32dp">

        <!-- Linker Kolom: Info & Permissies -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Installatie &amp; Permissies"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/vt5_light_blue" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUitleg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:text="@string/install_uitleg"
                    android:textColor="@color/vt5_on_surface"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/install_permissions_title"
                android:textColor="@color/vt5_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:columnCount="2">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbPermAudio"
                    android:text="@string/perm_audio_checkbox"
                    android:textColor="@color/vt5_on_surface" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbPermSaf"
                    android:text="@string/perm_saf_checkbox"
                    android:textColor="@color/vt5_on_surface" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbPermLocation"
                    android:text="@string/perm_location_checkbox"
                    android:textColor="@color/vt5_on_surface" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbPermCamera"
                    android:text="@string/perm_camera_checkbox"
                    android:textColor="@color/vt5_on_surface" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbPermBluetooth"
                    android:text="@string/perm_bluetooth_checkbox"
                    android:textColor="@color/vt5_on_surface" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbPermAlarm"
                    android:text="@string/perm_alarm_checkbox"
                    android:textColor="@color/vt5_on_surface" />
            </GridLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKiesDocuments"
                style="@style/Widget.VT5.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="8dp"
                android:text="@string/btn_kies_documents" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckFolders"
                style="@style/Widget.VT5.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:text="@string/btn_check_folders" />

            <!-- Installatiehulp -->
            <TextView
                android:id="@+id/tvInstallatieHelpTitel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/install_unknown_sources_title"
                android:textColor="@color/vt5_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInstallatieHelpDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/install_unknown_sources_desc"
                android:textColor="@color/vt5_on_surface"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenUnknownSources"
                style="@style/Widget.VT5.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:text="@string/install_unknown_sources_button" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/status_saf_niet_ingesteld"
                android:textAlignment="center"
                android:textColor="@color/vt5_on_surface" />

        </LinearLayout>

        <!-- Rechter Kolom: Trektellen & Data -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/sect_trektellen"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="@color/vt5_light_blue" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="@string/hint_login">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/hint_password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:columnCount="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBewaar"
                    style="@style/Widget.VT5.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/btn_bewaar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWis"
                    style="@style/Widget.VT5.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/btn_wis" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoginTest"
                    style="@style/Widget.VT5.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="4dp"
                    android:text="@string/btn_login_test" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadJsons"
                    style="@style/Widget.VT5.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_download_jsons" />
            </GridLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAliasPrecompute"
                style="@style/Widget.VT5.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="24dp"
                android:text="@string/btn_alias_precompute" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKlaar"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="@string/btn_klaar"
                android:textColor="@color/vt5_white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="@color/vt5_light_blue"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
