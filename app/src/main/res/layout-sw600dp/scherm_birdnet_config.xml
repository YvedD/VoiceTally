<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vt5_dark_gray"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BirdNET-GO Configuratie"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTerug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terug"
            android:minWidth="120dp" />
    </LinearLayout>

    <!-- Main Content: Two Column Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:spacing="24dp">

        <!-- LEFT COLUMN: Discovery & IP Presets -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Auto-Discovery Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Netwerk &amp; IP Auto-Discovery"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBirdNetAutoDiscover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan Netwerk &amp; IP-adressen (Subnet Scan)"
                android:layout_marginBottom="12dp" />

            <ProgressBar
                android:id="@+id/progressBirdNetDiscovery"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:visibility="gone"
                android:layout_marginBottom="12dp"
                style="?android:attr/progressBarStyleHorizontal" />

            <TextView
                android:id="@+id/tvBirdNetDiscoveryResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textColor="#FFE0E0E0"
                android:background="#22FFFFFF"
                android:padding="8dp"
                android:layout_marginBottom="8dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="8dp"
                android:background="#22FFFFFF"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/llDiscoveryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyDiscoveryResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pas Geselecteerde Server Toe"
                android:enabled="false"
                android:layout_marginBottom="16dp" />

            <!-- Quick IP Presets -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Snelle IP-Snelkoppelingen (Telpost Hotspots)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FF4CAF50"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetBirdNetLocal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="birdnet.local"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetHotspot"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="192.168.43.1"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetPiAp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="10.42.0.1"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPresetLan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="192.168.1.100"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            </LinearLayout>

            <!-- Recently Used IP Addresses -->
            <TextView
                android:id="@+id/tvHistoryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eerder Gebruikte IP-adressen (Historie)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF64B5F6"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llHistoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- RIGHT COLUMN: Manual Config, Actions & Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Status Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvBirdNetStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Niet geconfigureerd"
                android:textSize="14sp"
                android:textColor="#FFC0C0C0"
                android:background="#22FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- Manual Configuration Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Handmatige Configuratie"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgBirdNetProtocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <RadioButton
                    android:id="@+id/rbHttp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HTTP"
                    android:textColor="@android:color/white"
                    android:buttonTint="@android:color/white" />

                <RadioButton
                    android:id="@+id/rbHttps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HTTPS"
                    android:textColor="@android:color/white"
                    android:buttonTint="@android:color/white" />
            </RadioGroup>

            <EditText
                android:id="@+id/etBirdNetHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="bijv. 192.168.1.50, 192.168.43.1 of birdnet.local"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:textColorHint="#FF808080"
                android:background="#22FFFFFF"
                android:inputType="text"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <NumberPicker
                android:id="@+id/npBirdNetPort"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Minimale Betrouwbaarheid Filter (%)"
                android:textSize="13sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp" />

            <NumberPicker
                android:id="@+id/npBirdNetMinConfidence"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="8dp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBirdNetTestConnection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Testen"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBirdNetSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Opslaan"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBirdNetClear"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wissen"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            </LinearLayout>

            <!-- Information Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ Informatie &amp; Telpost Advies"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginBottom="8dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chrome op Android gebruikt een eigen mDNS-resolver, waardoor 'birdnet.local' in Chrome wel werkt, maar in Android apps niet.\n\nGebruik de knop 'Scan Netwerk &amp; IP-adressen' om direct het IP-adres van de Raspberry Pi te vinden op het netwerk of de hotspot. Zodra het IP-adres is ingesteld (bijv. 192.168.43.1 of 192.168.1.42), verbindt VoiceTally direct met BirdNET-GO."
                    android:textSize="12sp"
                    android:textColor="#FFB0B0B0"
                    android:background="#22FFFFFF"
                    android:padding="12dp" />
            </ScrollView>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
