<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/settings" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#85080E14" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="850dp"
            android:orientation="vertical"
            android:paddingLeft="40dp"
            android:paddingTop="48dp"
            android:paddingRight="40dp"
            android:paddingBottom="48dp">

            <!-- HEADER MET TERUG KNOP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTerug"
                    style="@style/Widget.VT5.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:text="←"
                    android:textSize="20sp" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_vt5_ai_horizon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bsi_datacentrum_titel"
                        android:textColor="@color/vt5_white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bsi_datacentrum_subtitel"
                        android:textColor="#D0FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- LIVE BSI STATUSKAART -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#CC121A24"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#227CAF"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvBsiStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bsi_status_red"
                        android:textColor="@color/vt5_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDbStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Database status: 0 tellingen geladen"
                        android:textColor="#A0FFFFFF"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartAutoPipeline"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/vt5_btn_glass_primary"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/bsi_pipeline_start_btn"
                        android:textColor="@color/vt5_white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:icon="@drawable/ic_vt5_ai_horizon"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconSize="24dp"
                        app:iconTint="@color/vt5_white"
                        app:rippleColor="#40D97A" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STAPPEN OVERZICHT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.08"
                android:text="DE 4 BSI DATAPROCES STAPPEN"
                android:textColor="@color/vt5_white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- STAP 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#99121A24"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#227CAF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/bsi_step1_title"
                            android:textColor="@color/vt5_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btnInfoStep1"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="10dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Info Stap 1"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@drawable/ic_info_circle_exclamation"
                            app:tint="@color/vt5_light_blue" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStep1Export"
                        style="@style/Widget.VT5.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Open Trektellen Export Downloader"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STAP 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#99121A24"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#227CAF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/bsi_step2_title"
                            android:textColor="@color/vt5_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btnInfoStep2"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="10dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Info Stap 2"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@drawable/ic_info_circle_exclamation"
                            app:tint="@color/vt5_light_blue" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStep2Import"
                        style="@style/Widget.VT5.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Start Excel Batch Import naar DB"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STAP 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#99121A24"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#227CAF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/bsi_step3_title"
                            android:textColor="@color/vt5_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btnInfoStep3"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="10dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Info Stap 3"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@drawable/ic_info_circle_exclamation"
                            app:tint="@color/vt5_light_blue" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStep3Weather"
                        style="@style/Widget.VT5.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Weerdata Aanvullen via Yr.no"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STAP 4 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#99121A24"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#227CAF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/bsi_step4_title"
                            android:textColor="@color/vt5_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btnInfoStep4"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="10dp"
                            android:background="?selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Info Stap 4"
                            android:focusable="true"
                            android:padding="4dp"
                            android:src="@drawable/ic_info_circle_exclamation"
                            app:tint="@color/vt5_light_blue" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStep4Train"
                        style="@style/Widget.VT5.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="BSI Neuraal Netwerk Trainen"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RESULTATEN -->
            <!-- ======================================================== -->
            <!-- SECTIE AI OOGST & PROGNOSES (OPKLAPBAAR MENU)            -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResultsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#CC121A24"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#117CAF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Opklapbare Header Bar -->
                    <LinearLayout
                        android:id="@+id/layoutHeaderResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.05"
                            android:text="BIOLOGISCHE INTELLIGENTIE &amp; RESULTATEN"
                            android:textColor="@color/vt5_white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvArrowResults"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="▼"
                            android:textColor="@color/vt5_light_blue"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Inhoud van het opklapbare menu (standaard ingeklapt) -->
                    <LinearLayout
                        android:id="@+id/layoutResultsContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:paddingBottom="20dp"
                        android:visibility="gone">

                        <!-- 1. 3-Daagse Trekprognose -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAiForecast3Days"
                                style="@style/Widget.VT5.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="3-Daagse Trekprognose"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/btnInfoForecast"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="10dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="Info Trekprognose"
                                android:focusable="true"
                                android:padding="4dp"
                                android:src="@drawable/ic_info_circle_exclamation"
                                app:tint="@color/vt5_light_blue" />
                        </LinearLayout>

                        <!-- 2. KrentenMonitor -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnKrentenMonitor"
                                style="@style/Widget.VT5.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="KrentenMonitor &amp; Fenologie"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/btnInfoKrenten"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="10dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="Info KrentenMonitor"
                                android:focusable="true"
                                android:padding="4dp"
                                android:src="@drawable/ic_info_circle_exclamation"
                                app:tint="@color/vt5_light_blue" />
                        </LinearLayout>

                        <!-- 3. Teldag Verslagen & AI Analyses -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAiDailyReports"
                                style="@style/Widget.VT5.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Teldag Verslagen &amp; AI Analyses"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/btnInfoDailyReports"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="10dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="Info Teldag Verslagen"
                                android:focusable="true"
                                android:padding="4dp"
                                android:src="@drawable/ic_info_circle_exclamation"
                                app:tint="@color/vt5_light_blue" />
                        </LinearLayout>

                        <!-- 4. Soortenanalyse & Windrozen -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSoortAnalyse"
                                style="@style/Widget.VT5.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Soortenanalyse &amp; Windrozen"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/btnInfoSoortAnalyse"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="10dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="Info Soortenanalyse"
                                android:focusable="true"
                                android:padding="4dp"
                                android:src="@drawable/ic_info_circle_exclamation"
                                app:tint="@color/vt5_light_blue" />
                        </LinearLayout>

                        <!-- 5. AI-Historiek & Auditlogs -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAiEvaluation"
                                style="@style/Widget.VT5.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="AI-Historiek &amp; Auditlogs"
                                android:textSize="14sp" />

                            <ImageView
                                android:id="@+id/btnInfoAiEvaluation"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="10dp"
                                android:background="?selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:contentDescription="Info AI Historiek"
                                android:focusable="true"
                                android:padding="4dp"
                                android:src="@drawable/ic_info_circle_exclamation"
                                app:tint="@color/vt5_light_blue" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>