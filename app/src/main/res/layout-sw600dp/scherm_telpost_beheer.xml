<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/vt5_black"
    android:orientation="vertical"
    android:paddingTop="30dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTerug"
            style="@style/Widget.VT5.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:text="@string/instellingen_back_arrow"
            android:textSize="22sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/telpost_beheer_titel"
            android:textColor="@color/vt5_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.3"
        android:background="@color/vt5_on_surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="24dp">

        <!-- Linkse paneel: Selectie en Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="24dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/telpost_beheer_hint_select"
                app:boxStrokeColor="@color/vt5_light_blue"
                app:hintTextColor="@color/vt5_light_blue">

                <AutoCompleteTextView
                    android:id="@+id/acTelpost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/vt5_on_surface" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/telpost_beheer_instructions"
                android:textColor="@color/vt5_light_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Locatie: - "
                android:textColor="@color/vt5_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/Widget.VT5.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/telpost_beheer_btn_reset"
                android:textColor="@color/vt5_red"
                app:strokeColor="@color/vt5_red" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.VT5.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/telpost_beheer_btn_save"
                app:icon="@android:drawable/ic_menu_save" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:alpha="0.7"
                android:text="De eerste telpost die u bewaart, wordt automatisch de 'hoofdtelpost' voor uw regionale 35km-cluster. Dit is cruciaal voor de nauwkeurigheid van de biologische data: weergegevens en trek-curves worden namelijk per cluster berekend, omdat lokale omstandigheden bepalend zijn voor de trek-intensiteit in uw regio."
                android:textColor="@color/vt5_white"
                android:textSize="14sp"
                android:textStyle="italic" />

        </LinearLayout>

        <!-- Rechtse paneel: Kaart -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabLayers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="24dp"
                android:contentDescription="@string/telpost_beheer_layers"
                app:backgroundTint="@color/vt5_light_blue"
                app:srcCompat="@android:drawable/ic_menu_mapmode"
                app:tint="@color/vt5_white" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabMyLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="24dp"
                android:contentDescription="@string/telpost_beheer_btn_my_location"
                app:backgroundTint="@color/vt5_light_blue"
                app:srcCompat="@android:drawable/ic_menu_mylocation"
                app:tint="@color/vt5_white" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
