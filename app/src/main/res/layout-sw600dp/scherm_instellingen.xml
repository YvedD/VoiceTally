<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vt5_black"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTerug"
            style="@style/Widget.VT5.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:text="@string/instellingen_back_arrow"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvTitel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:text="@string/instellingen_titel"
            android:textColor="@color/vt5_white"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.3"
        android:background="@color/vt5_on_surface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:paddingTop="16dp">

            <!-- 1. Tekst & Schaal -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#111111"
                app:cardCornerRadius="16dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Tekst &amp; Schaal"
                        android:textColor="@color/vt5_light_blue"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/instellingen_lettergrootte_partials_label"
                            android:textColor="@color/vt5_on_surface" />

                        <NumberPicker
                            android:id="@+id/npLettergroottePartials"
                            android:layout_width="80dp"
                            android:layout_height="50dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/instellingen_lettergrootte_finals_label"
                            android:textColor="@color/vt5_on_surface" />

                        <NumberPicker
                            android:id="@+id/npLettergrootteFinals"
                            android:layout_width="80dp"
                            android:layout_height="50dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/instellingen_lettergrootte_tegels_label"
                            android:textColor="@color/vt5_on_surface" />

                        <NumberPicker
                            android:id="@+id/npLettergrootteTegels"
                            android:layout_width="80dp"
                            android:layout_height="50dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Kleuren -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#111111"
                app:cardCornerRadius="16dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Kleuren &amp; Thema"
                        android:textColor="@color/vt5_light_blue"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/instellingen_bg_color_label"
                        android:textColor="@color/vt5_on_surface" />

                    <Spinner
                        android:id="@+id/spBackgroundColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/instellingen_text_color_label"
                        android:textColor="@color/vt5_on_surface" />

                    <Spinner
                        android:id="@+id/spTextColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Kleur Partials"
                        android:textColor="@color/vt5_on_surface" />

                    <Spinner
                        android:id="@+id/spPartialsTextColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Kleur Onbekend"
                        android:textColor="@color/vt5_on_surface" />

                    <Spinner
                        android:id="@+id/spUnmatchedPartialsTextColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Kleur Finals"
                        android:textColor="@color/vt5_on_surface" />

                    <Spinner
                        android:id="@+id/spFinalsTextColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Gedrag -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#111111"
                app:cardCornerRadius="16dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Telling &amp; Gedrag"
                        android:textColor="@color/vt5_light_blue"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbDynamicTileSorting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/instellingen_dynamic_tile_sorting_checkbox"
                        android:textColor="@color/vt5_on_surface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/instellingen_double_tap_title"
                        android:textColor="@color/vt5_on_surface"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDoubleTap5"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="5"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDoubleTap10"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="10"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDoubleTap50"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="50"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDoubleTap100"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="100"
                            android:textSize="12dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/instellingen_pending_tiles_title"
                        android:textColor="@color/vt5_on_surface"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPendingTiles2"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="2"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPendingTiles3"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="3"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPendingTiles5"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="5"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPendingTiles8"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="8"
                            android:textSize="12dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPendingTiles10"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="10"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPendingTiles12"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="12"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPendingTiles15"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="15"
                            android:textSize="12dp" />
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Fav Limiet"
                        android:textColor="@color/vt5_on_surface"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFav15"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="15"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFav20"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="20"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFav25"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="25"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFav30"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="30"
                            android:textSize="12dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFav35"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="35"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFav40"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="40"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFav75"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="75"
                            android:textSize="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFavAll"
                            style="@style/Widget.VT5.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:checkable="true"
                            android:padding="2dp"
                            android:text="Alles"
                            android:textSize="12dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Grafieken -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#111111"
                app:cardCornerRadius="16dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="Grafiek Instellingen"
                        android:textColor="@color/vt5_light_blue"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lijndikte (DP)"
                            android:textColor="@color/vt5_on_surface" />

                        <NumberPicker
                            android:id="@+id/npChartThickness"
                            android:layout_width="80dp"
                            android:layout_height="100dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Kleur Wind (Beaufort)"
                        android:textColor="@color/vt5_on_surface" />

                    <Spinner
                        android:id="@+id/spChartColorWind"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kleur Aantal (Trek)"
                        android:textColor="@color/vt5_on_surface" />

                    <Spinner
                        android:id="@+id/spChartColorTrek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kleur Aantal (Terug)"
                        android:textColor="@color/vt5_on_surface" />

                    <Spinner
                        android:id="@+id/spChartColorTerug"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. AI & Toestemmingen -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                app:cardBackgroundColor="#111111"
                app:cardCornerRadius="16dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="AI &amp; Toestemmingen"
                        android:textColor="@color/vt5_light_blue"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbAiEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/instellingen_ai_checkbox"
                        android:textColor="@color/vt5_on_surface" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbUseNeuralInference"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Gebruik neurale prognose (Neural inference)"
                        android:textColor="@color/vt5_on_surface" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbUseDailyAnalysisWeights"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Gebruik teldag-verslagen in AI (Daily analysis weights)"
                        android:textColor="@color/vt5_on_surface" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbServerResponseLogging"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/instellingen_server_response_logging_checkbox"
                        android:textColor="@color/vt5_on_surface" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.1"
                        android:background="@android:color/white" />

                    <!-- NIEUW: Krentenfilter (Birds of Interest) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Birds of Interest (Krentenfilter)"
                        android:textColor="@color/vt5_light_blue"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="12dp"
                        android:text="De krentenfilter markeert zeldzame soorten op basis van jouw persoonlijke database. Soorten die minder vaak zijn waargenomen dan de drempelwaarde krijgen een boost in de AI-prognose. Let op: het aanpassen van de drempelwaarde vereist een nieuwe AI-training om de lijst bij te werken."
                        android:textColor="@color/vt5_on_surface"
                        android:alpha="0.8"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Drempel (max. waarnemingen)"
                            android:textColor="@color/vt5_on_surface" />

                        <NumberPicker
                            android:id="@+id/npKrentenThreshold"
                            android:layout_width="80dp"
                            android:layout_height="100dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApplyKrentenThreshold"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="DREMPEL TOEPASSEN"
                        app:icon="@android:drawable/ic_menu_save" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:alpha="0.7"
                        android:text="Soorten met minder waarnemingen dan deze drempel worden als 'krent' gemarkeerd voor de AI-monitor."
                        android:textColor="@color/vt5_on_surface"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenKrentenMonitor"
                        style="@style/Widget.VT5.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="BEKIJK KRENTEN-MONITOR"
                        app:icon="@android:drawable/ic_menu_view" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:alpha="0.1"
                        android:background="@android:color/white" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbPermAudio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:text="Audio"
                            android:textColor="@color/vt5_on_surface" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbPermSaf"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:text="Opslag"
                            android:textColor="@color/vt5_on_surface" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbPermLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:text="GPS"
                            android:textColor="@color/vt5_on_surface" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbPermCamera"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:text="Camera"
                            android:textColor="@color/vt5_on_surface" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbPermBluetooth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:text="Bluetooth"
                            android:textColor="@color/vt5_on_surface" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbPermAlarm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:text="Alarm"
                            android:textColor="@color/vt5_on_surface" />
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>
    </ScrollView>

</LinearLayout>
