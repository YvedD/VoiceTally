<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- HOOFD CONTAINERCARD TABLET: 80% breedte x 60% hoogte gecentreerd op scherm -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFloatingInfo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/floating_info_bg_color"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/grafiek_achtergrondkleur"
        app:strokeWidth="3dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- OPTIONELE ACHTERGRONDAAFBEELDING (BLACK-BOX HERGEBRUIK) -->
            <ImageView
                android:id="@+id/ivFloatingInfoBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- GESCHAALDE KOP-AFBEELDING TABLET BOVEN DE TITEL (VOLLEDIGE BREEDTE, PASSEND EN VOLLEDIG ZICHTBAAR) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFloatingInfoHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivFloatingInfoHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/kraanvogels_bckgrnd" />
                </com.google.android.material.card.MaterialCardView>

                <!-- KOPSECTIE TABLET: ICOON + TITEL (VAST BOVENAAN) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/ivFloatingInfoIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info_circle_exclamation" />

                    <TextView
                        android:id="@+id/tvFloatingInfoTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:text="@string/bsi_info_datacentrum_title"
                        android:textColor="@color/floating_info_title_color"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/grafiek_beheer_tellingen" />

                <!-- SCROLLBARE TEKSTINHOUD (GEKAPSELD IN SCROLLVIEW, SLUITKNOP ERBUITEN) -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvFloatingInfoBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="6dp"
                            android:text="@string/bsi_info_datacentrum_body"
                            android:textColor="@color/floating_info_text_color"
                            android:textSize="16sp" />
                    </LinearLayout>
                </ScrollView>

                <!-- DIT BERICHT NIET MEER TONEN CHECKBOX TABLET -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbDontShowAgain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/onboarding_dont_show_again"
                    android:textColor="@color/floating_info_text_color"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:buttonTint="@color/floating_info_border_color" />

                <!-- SLUITKNOP VAST ONDERAAN (BUITEN DE SCROLLVIEW) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFloatingInfoClose"
                    style="@style/Widget.VT5.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Sluiten"
                    android:textColor="@color/floating_info_button_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/floating_info_button_stroke"
                    app:strokeWidth="2dp" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
