<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/vt5_dark_gray"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/vt5_light_blue"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvDirectionHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/vt5_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgSeason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/rbYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Volledig Jaar"
                    android:textColor="@color/vt5_white"
                    android:textSize="14sp"
                    android:checked="true"
                    android:buttonTint="@color/vt5_white" />
                <RadioButton
                    android:id="@+id/rbSpring"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Voorjaar"
                    android:textColor="@color/vt5_white"
                    android:textSize="14sp"
                    android:buttonTint="@color/vt5_white" />
                <RadioButton
                    android:id="@+id/rbAutumn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Najaar"
                    android:textColor="@color/vt5_white"
                    android:textSize="14sp"
                    android:buttonTint="@color/vt5_white" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbShowTrek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chart_show_trek"
                android:checked="true"
                android:paddingStart="12dp"
                android:textSize="16sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbShowReturn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/chart_show_return"
                android:checked="true"
                android:paddingStart="12dp"
                android:textSize="16sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbShowWind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/chart_show_wind"
                android:checked="true"
                android:paddingStart="12dp"
                android:textSize="16sp" />

        </LinearLayout>

        <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
            android:id="@+id/chartDirection"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:padding="6dp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
