<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vt5_black"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/top_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vt5_black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="VT5  - tablet layout"
            android:textColor="@color/vt5_green"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnBirdNet"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/favicon_32x32"
            android:visibility="visible"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnToggleAlarm"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_idle_alarm"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnMasterClientConnection"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_mc_wifi"
            app:tint="#808080" />

        <ImageButton
            android:id="@+id/btnShowMasterQr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_qr_code"
            android:visibility="gone"
            app:tint="#808080" />

        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@android:color/white" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vt5_outline" />

    <!-- BirdNet-GO Area (Ticker + Switch) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="#1A1A11"
        app:cardCornerRadius="8dp"
        app:strokeColor="#FFFF00"
        app:strokeWidth="2dp">

        <LinearLayout
            android:id="@+id/birdnet_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBirdNetPendingTicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Wachten op BirdNet-GO..."
                    android:textColor="@color/vt5_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMasterClientStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vt5_on_surface"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swBirdNetEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_gravity="center_vertical"
                android:checked="true"
                android:contentDescription="@string/telling_birdnet_switch_description"
                android:minWidth="72dp"
                android:visibility="visible"
                app:thumbTint="@color/vt5_white"
                app:trackTint="@color/vt5_green"
                app:useMaterialThemeColors="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vt5_outline" />

    <!-- Main Content Area: Split into Left (Speech) and Right (Actions/Tiles) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- LEFT PANEL: Vertical Speech Bars -->
        <LinearLayout
            android:layout_width="325dp"
            android:layout_height="match_parent"
            android:background="#0A0A0A"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- BirdNet Detections (Only visible when active) -->
            <TextView
                android:id="@+id/labelBirdNet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text="BIRDNET-GO"
                android:textColor="@color/vt5_orange"
                android:textSize="10sp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBirdNetDetections"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="1dp"
                android:layout_weight="1"
                android:visibility="gone"
                app:cardCornerRadius="8dp"
                app:strokeColor="@color/vt5_orange"
                app:strokeWidth="2dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewBirdNetDetections"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#111111" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text="PARTIALS"
                android:textColor="#888888"
                android:textSize="10sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSpeechPartials"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:strokeColor="@color/vt5_light_blue"
                app:strokeWidth="2dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewSpeechPartials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#111111" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text="FINALS"
                android:textColor="#888888"
                android:textSize="10sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSpeechFinals"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="8dp"
                app:strokeColor="@color/vt5_green"
                app:strokeWidth="2dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewSpeechFinals"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#111111" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/vt5_outline" />

        <!-- RIGHT PANEL: Action Buttons & Species Tiles -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Action Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveClose"
                    style="@style/Widget.VT5.Button.Outlined.IconOnly"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:icon="@drawable/ic_action_sum"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddSoorten"
                    style="@style/Widget.VT5.Button.Outlined.IconOnly"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    app:icon="@drawable/ic_action_add"
                    app:iconTint="@null" />

                <!-- De knop nu netjes in de groep -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAfronden"
                    style="@style/Widget.VT5.Button.Outlined.IconOnly"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    app:icon="@drawable/ic_action_upload"
                    app:iconTint="@null" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Totals Display helemaal rechts -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#222222"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tvDailyMainTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZW 0"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="24dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="#444444" />

                    <TextView
                        android:id="@+id/tvDailyReturnTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NO 0"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewSpecies"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
