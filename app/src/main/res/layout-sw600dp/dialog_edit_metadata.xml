<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/vt5_outline">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vt5_black">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/rootScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@+id/bottomBar"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="32dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@color/vt5_light_blue"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="@string/meta_titel_basis"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@android:color/white" />

                <!-- Grid voor basis metadata -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDatum"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="@string/meta_datum"
                        app:boxBackgroundMode="outline">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDatum"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:clickable="true"
                            android:focusable="false"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTijd"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="8dp"
                        android:hint="@string/meta_tijd"
                        app:boxBackgroundMode="outline">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTijd"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:clickable="true"
                            android:focusable="false"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTelpost"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="8dp"
                        android:hint="@string/meta_telpost"
                        app:boxBackgroundMode="outline"
                        app:endIconMode="dropdown_menu">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acTelpost"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTypeTelling"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="8dp"
                        android:hint="@string/meta_typetelling"
                        app:boxBackgroundMode="outline"
                        app:endIconMode="dropdown_menu">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acTypeTelling"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </GridLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTellers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:hint="@string/meta_tellers"
                    app:boxBackgroundMode="outline">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTellers"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Weercondities"
                    android:textColor="@color/vt5_light_blue"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWindrichting"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="@string/meta_windrichting"
                        app:boxBackgroundMode="outline"
                        app:endIconMode="dropdown_menu">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acWindrichting"
                            android:layout_width="match_parent"
                            android:layout_height="60dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWindkracht"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="8dp"
                        android:hint="@string/meta_windkracht"
                        app:boxBackgroundMode="outline"
                        app:endIconMode="dropdown_menu">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acWindkracht"
                            android:layout_width="match_parent"
                            android:layout_height="60dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTemperatuur"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="8dp"
                        android:hint="@string/meta_temperatuur"
                        app:boxBackgroundMode="outline">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTemperatuur"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNeerslag"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="8dp"
                        android:hint="@string/meta_neerslag"
                        app:boxBackgroundMode="outline"
                        app:endIconMode="dropdown_menu">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/acNeerslag"
                            android:layout_width="match_parent"
                            android:layout_height="60dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </GridLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWeerAuto"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="16dp"
                    android:text="@string/meta_weer_auto"
                    app:backgroundTint="@color/vt5_outline"
                    app:icon="@drawable/ic_weather"
                    app:iconSize="24dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOpmerkingen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:hint="@string/meta_opmerkingen"
                    app:boxBackgroundMode="outline">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOpmerkingen"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="top"
                        android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnnuleer"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/annuleer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerder"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/verder" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
