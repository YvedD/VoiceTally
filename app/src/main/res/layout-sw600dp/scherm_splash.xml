<?xml version="1.0" encoding="utf-8"?>
<!--
    VT5 Splash Screen Layout (Tablet)
    Geoptimaliseerd voor grotere schermen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="45dp"
    android:layout_marginBottom="60dp"
    android:background="@color/vt5_black">

    <!-- Container voor de Logo-transitie (Tablet) -->
    <FrameLayout
        android:layout_width="550dp"
        android:layout_height="550dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/vt5" />

        <!-- AI Layer: Groter BSI-powered oog voor tablets -->
        <ImageView
            android:id="@+id/ivAiLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:contentDescription="BSI Logo"
            android:src="@drawable/ic_vt5_ai_horizon" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ProgressBar
            android:id="@+id/pbLoading"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/vt5_light_blue" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voicetally 5 app version 1.0.3-f"
            android:textAlignment="center"
            android:textColor="#5292DC"
            android:textSize="16sp" />
    </LinearLayout>

</FrameLayout>
