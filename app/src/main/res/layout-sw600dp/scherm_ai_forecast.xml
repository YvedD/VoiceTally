<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vt5_black"
    android:orientation="vertical">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="BSI Prognose komende 3 dagen"
        android:textAlignment="center"
        android:textColor="@color/vt5_white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Telpost Selection Header Card (Tablet) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTelpostSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="8dp"
        app:cardBackgroundColor="#1A222D"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/vt5_light_blue"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTelpostTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 PROGNOSE TELPOST"
                    android:textColor="@color/vt5_light_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedTelpostInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Laden telpost..."
                    android:textColor="@color/vt5_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeTelpost"
                style="@style/Widget.VT5.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WIJZIG TELPOST 📍"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Start Forecast Action Button (Tablet) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartForecastCalculation"
        style="@style/Widget.VT5.Button.Outlined"
        android:layout_width="360dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="8dp"
        android:text="🚀 BEREKEN 3-DAAGSE PROGNOSE"
        android:textColor="@color/vt5_light_blue"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="10dp"
        app:strokeColor="@color/vt5_light_blue"
        app:strokeWidth="2dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.3"
        android:background="@color/vt5_on_surface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <!-- Dagen onder elkaar -->
        <LinearLayout
            android:id="@+id/forecastContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </androidx.core.widget.NestedScrollView>

    <!-- Footer actie -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/Widget.VT5.Button.Outlined"
        android:layout_width="300dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_margin="24dp"
        android:text="Sluiten"
        android:textSize="18sp"
        app:cornerRadius="12dp" />

</LinearLayout>
